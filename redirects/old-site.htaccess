# 301 redirects from the old site to https://hutoautok.hu
# Paste ABOVE the '# BEGIN WordPress' block in the old site's .htaccess.
# Generated by redirects/build-redirects.js - do not edit by hand.
<IfModule mod_rewrite.c>
RewriteEngine On

# Only the old domain (autotherm.hu and www.autotherm.hu)
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^$ https://hutoautok.hu/hu?from=old [R=301,L,QSD]

# 1:1 pages (same address on the new site)
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^hu/(kik-vagyunk|termekeink|szerviz|rakterhuto-szerviz|miert-mi|kepgaleria|kapcsolat|arajanlatkeres|hutoauto-blog|haszonjarmu-felepitmenyek|jarmufelepitmeny-javitas|szervizunk|altalanos-szerzodesi-feltetelek|adatkezelesi-tajekoztato|ginop-palyazat)/?$ https://hutoautok.hu/hu/$1?from=old [R=301,L,QSD]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^en/(who-are-we|our-products|why-us|galeries|contact|quotation|hutoautoblog|commercial-vehicle-bodies|van-isolations|deceased-transport|cooled-refrigerated-vehicle-bodies)/?$ https://hutoautok.hu/en/$1?from=old [R=301,L,QSD]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^de/(wer-sind-wir-3|kuehlfahrzeug|warum-gerade-wir|aufbauten-galerie|kontakt|anfrage|hutoauto-blog-2)/?$ https://hutoautok.hu/de/$1?from=old [R=301,L,QSD]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^ro/(cine-suntem-noi|carosari-furgoane-frigorifice|galerie-foto|contact-2|cerere-oferta|blog)/?$ https://hutoautok.hu/ro/$1?from=old [R=301,L,QSD]

# Language home pages
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^(hu|en|de|ro)/?$ https://hutoautok.hu/$1?from=old [R=301,L,QSD]

# thank-you / campaign pages -> home
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^hu/.*(hutoauto$|koszonjuk|danke|dande|thank-you|multumesc|multumim|blackfriday|black_friday|jofogas|27-evesek|sikeres-igenyles|proba-csali|ebook|hentesek|cukraszatok|language|allaslehetoseg|munkatars|koronavirus).*$ https://hutoautok.hu/hu?from=old [R=301,L,QSD,NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^en/.*(hutoauto$|koszonjuk|danke|dande|thank-you|multumesc|multumim|blackfriday|black_friday|jofogas|27-evesek|sikeres-igenyles|proba-csali|ebook|hentesek|cukraszatok|language|allaslehetoseg|munkatars|koronavirus).*$ https://hutoautok.hu/en?from=old [R=301,L,QSD,NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^de/.*(hutoauto$|koszonjuk|danke|dande|thank-you|multumesc|multumim|blackfriday|black_friday|jofogas|27-evesek|sikeres-igenyles|proba-csali|ebook|hentesek|cukraszatok|language|allaslehetoseg|munkatars|koronavirus).*$ https://hutoautok.hu/de?from=old [R=301,L,QSD,NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^ro/.*(hutoauto$|koszonjuk|danke|dande|thank-you|multumesc|multumim|blackfriday|black_friday|jofogas|27-evesek|sikeres-igenyles|proba-csali|ebook|hentesek|cukraszatok|language|allaslehetoseg|munkatars|koronavirus).*$ https://hutoautok.hu/ro?from=old [R=301,L,QSD,NC]

# galleries / 3D / portfolio -> gallery
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^hu/.*(3d|galeri|gallery|galerie|portfolio|kepgaleria|foto|umbauten|hutos-atalakitasok|husos-hutoauto-kepek).*$ https://hutoautok.hu/hu/kepgaleria?from=old [R=301,L,QSD,NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^en/.*(3d|galeri|gallery|galerie|portfolio|kepgaleria|foto|umbauten|hutos-atalakitasok|husos-hutoauto-kepek).*$ https://hutoautok.hu/en/galeries?from=old [R=301,L,QSD,NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^de/.*(3d|galeri|gallery|galerie|portfolio|kepgaleria|foto|umbauten|hutos-atalakitasok|husos-hutoauto-kepek).*$ https://hutoautok.hu/de/aufbauten-galerie?from=old [R=301,L,QSD,NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^ro/.*(3d|galeri|gallery|galerie|portfolio|kepgaleria|foto|umbauten|hutos-atalakitasok|husos-hutoauto-kepek).*$ https://hutoautok.hu/ro/galerie-foto?from=old [R=301,L,QSD,NC]

# service -> service
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^hu/.*(servi|szerviz).*$ https://hutoautok.hu/hu/szerviz?from=old [R=301,L,QSD,NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^en/.*(servi|szerviz).*$ https://hutoautok.hu/en/our-products?from=old [R=301,L,QSD,NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^de/.*(servi|szerviz).*$ https://hutoautok.hu/de/kuehlfahrzeug?from=old [R=301,L,QSD,NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^ro/.*(servi|szerviz).*$ https://hutoautok.hu/ro/carosari-furgoane-frigorifice?from=old [R=301,L,QSD,NC]

# vehicles / bodies -> products
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^hu/.*(felepitmeny|aufbauten|suprastructuri|carosa|kuehl|kuhl|vans?(-|$)|vehicle|35-ton|3-5-ton|furgon|autoutilitare|dube|nutzwagen|bestattungswagen|transport-funerar|frigorific|elektro|halottszallito).*$ https://hutoautok.hu/hu/termekeink?from=old [R=301,L,QSD,NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^en/.*(felepitmeny|aufbauten|suprastructuri|carosa|kuehl|kuhl|vans?(-|$)|vehicle|35-ton|3-5-ton|furgon|autoutilitare|dube|nutzwagen|bestattungswagen|transport-funerar|frigorific|elektro|halottszallito).*$ https://hutoautok.hu/en/our-products?from=old [R=301,L,QSD,NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^de/.*(felepitmeny|aufbauten|suprastructuri|carosa|kuehl|kuhl|vans?(-|$)|vehicle|35-ton|3-5-ton|furgon|autoutilitare|dube|nutzwagen|bestattungswagen|transport-funerar|frigorific|elektro|halottszallito).*$ https://hutoautok.hu/de/kuehlfahrzeug?from=old [R=301,L,QSD,NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^ro/.*(felepitmeny|aufbauten|suprastructuri|carosa|kuehl|kuhl|vans?(-|$)|vehicle|35-ton|3-5-ton|furgon|autoutilitare|dube|nutzwagen|bestattungswagen|transport-funerar|frigorific|elektro|halottszallito).*$ https://hutoautok.hu/ro/carosari-furgoane-frigorifice?from=old [R=301,L,QSD,NC]

# everything else (articles) -> blog
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^hu/.+$ https://hutoautok.hu/hu/hutoauto-blog?from=old [R=301,L,QSD,NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^en/.+$ https://hutoautok.hu/en/hutoautoblog?from=old [R=301,L,QSD,NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^de/.+$ https://hutoautok.hu/de/hutoauto-blog-2?from=old [R=301,L,QSD,NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^ro/.+$ https://hutoautok.hu/ro/blog?from=old [R=301,L,QSD,NC]

# Un-prefixed old paths (e.g. /portfolio/..., /hutos-atalakitasok/) -> gallery / home
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^(portfolio|hutos-atalakitasok|husos-hutoauto-kepek|galeria-.*)(/.*)?$ https://hutoautok.hu/hu/kepgaleria?from=old [R=301,L,QSD,NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autotherm\.hu$ [NC]
RewriteRule ^koszonjuk-ajanlatkereset/?$ https://hutoautok.hu/hu?from=old [R=301,L,QSD]
</IfModule>
