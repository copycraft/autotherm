/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

/images/*.webp
  Cache-Control: public,max-age=31536000,immutable
  Content-Type: image/webp

/images/*.jpg
  Cache-Control: public,max-age=31536000,immutable

/images/*.png
  Cache-Control: public,max-age=31536000,immutable

/videos/*
  Cache-Control: public,max-age=31536000,immutable

/*
  Supports-Loading-Mode: credentialed
  X-Content-Type-Options: nosniff
